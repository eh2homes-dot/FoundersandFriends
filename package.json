{
  "name": "founders-and-friends",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Job board for the OpCo and PropTech hubs. Static site plus a scheduled scraper.",
  "scripts": {
    "build": "echo 'Static site - nothing to build.'",
    "detect": "node scripts/detect-ats.js",
    "detect:dry": "node scripts/detect-ats.js --dry",
    "scrape": "node run.js",
    "scrape:opco": "node run.js --hub=opco",
    "scrape:proptech": "node run.js --hub=proptech",
    "scrape:dry": "node run.js --dry",
    "serve": "npx --yes serve .",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "4.118.0"
  }
}
