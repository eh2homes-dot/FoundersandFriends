{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundersandfriends",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",

  "assets": {
    // Serve ONLY the site folder. Pointing at "." would sweep in node_modules
    // and publish your .git directory.
    "directory": "./site",
    "binding": "ASSETS",

    // Any path that is not a real file returns index.html, so deep links work.
    "not_found_handling": "single-page-application",

    // THE LINE THAT WAS MISSING. With static assets, Cloudflare serves assets
    // BEFORE running the Worker — and with SPA handling above, every unmatched
    // path resolves to index.html. The Worker was never reached, which is why
    // /api/stats returned the homepage and every admin sign-in failed.
    //
    // This runs worker.js first for /api/*, and serves assets everywhere else.
    "run_worker_first": ["/api/*"]
  },

  // Click tracking and applications. Both tables live in this one database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founders-clicks",
      "database_id": "b2fac751-e9ae-4190-850f-47426681d322"
    }
  ],

  // Logs from console.error in worker.js.
  "observability": {
    "enabled": true
  }
}
