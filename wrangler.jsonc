{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundersandfriends",
  "compatibility_date": "2026-08-01",

  // THE LINE THAT MATTERS. Without "main", wrangler builds a static-assets-only
  // Worker and ignores worker.js entirely — every /api/* path then falls through
  // to index.html, which is why /api/stats returned the homepage.
  "main": "worker.js",

  "assets": {
    // Serve ONLY the site folder. Pointing at "." would sweep in node_modules
    // and publish your .git directory.
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Click tracking and applications. Both tables live in this one database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "founders-clicks",
      "database_id": "b2fac751-e9ae-4190-850f-47426681d322"
    }
  ],

  // Logs from console.error in worker.js — how you see why an email failed or a
  // database write was rejected.
  "observability": {
    "enabled": true
  }
}
